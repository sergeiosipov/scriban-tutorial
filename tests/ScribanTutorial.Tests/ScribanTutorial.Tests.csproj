<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ScribanTutorial.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="Scriban" Version="7.2.0" />
    <PackageReference Include="TextMateSharp" Version="2.0.3" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- Share helpers with the WASM project rather than re-implementing them.
       The linked Compile references keep one source of truth. -->
  <ItemGroup>
    <Compile Include="..\..\src\ScribanTutorial\Services\ContentNormalize.cs"
             Link="Shared\ContentNormalize.cs" />
    <Compile Include="..\..\src\ScribanTutorial\Services\JsonToScriban.cs"
             Link="Shared\JsonToScriban.cs" />
    <Compile Include="..\..\src\ScribanTutorial\Services\ScribanRunner.cs"
             Link="Shared\ScribanRunner.cs" />
    <Compile Include="..\..\src\ScribanTutorial\Services\Models.cs"
             Link="Shared\Models.cs" />
    <Compile Include="..\..\src\ScribanTutorial\Services\SearchIndex.cs"
             Link="Shared\SearchIndex.cs" />
    <Compile Include="..\..\tools\ContentBuilder\MarkdownRenderer.cs"
             Link="Shared\MarkdownRenderer.cs" />
    <Compile Include="..\..\tools\ContentBuilder\TextMateHighlighter.cs"
             Link="Shared\TextMateHighlighter.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
