# .NET build artifacts
bin/
obj/
publish/
*.user
*.suo
.vs/
.vscode/
.claude/

# Rider / Resharper
.idea/
*.DotSettings.user

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Generated lesson HTML (regenerated by ContentBuilder on each build)
src/ScribanTutorial/wwwroot/lessons/**/*.html
# Same for the data-model HTML pretty-printed by ContentBuilder.
src/ScribanTutorial/wwwroot/lessons/**/02-datamodel.html
# Per-exercise bundle.json the runtime fetches in one round trip.
src/ScribanTutorial/wwwroot/lessons/**/bundle.json
# Site search index the /search page fetches once (regenerated by ContentBuilder).
src/ScribanTutorial/wwwroot/search-index.json
# Theory heading outline sidecars feeding the in-lesson TOC (regenerated by ContentBuilder).
src/ScribanTutorial/wwwroot/lessons/**/01-theory.toc.json
# Function-reference index the /reference page fetches once (regenerated by ContentBuilder).
src/ScribanTutorial/wwwroot/reference.json
# Sitemap derived from the manifest (regenerated by ContentBuilder).
src/ScribanTutorial/wwwroot/sitemap.xml

# Local dev server logs
*.log
