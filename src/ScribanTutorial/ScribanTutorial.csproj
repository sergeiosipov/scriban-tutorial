<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScribanTutorial</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Lets index.html use fingerprint placeholders (e.g. css/app#[.{fingerprint}].css)
         that the build rewrites to the hashed asset names. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
    <PackageReference Include="Scriban" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- DiffPlex is used only by ExerciseBlock/DiffView on lesson pages; keep it
         out of the eager boot download. App.razor's OnNavigateAsync fetches it on
         the first lesson navigation. The .wasm extension matches the default
         webcil-in-wasm assembly packaging. -->
    <BlazorWebAssemblyLazyLoad Include="DiffPlex.wasm" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lesson SOURCE files are ContentBuilder inputs read from disk at build
         time and never fetched by the app (ContentService requests only the
         generated *.html, bundle.json and 01-theory.toc.json), so keep them out
         of the static web assets for both build and publish. -->
    <Content Remove="wwwroot\lessons\**\*.md" />
    <Content Remove="wwwroot\lessons\**\03-expected.txt" />
    <Content Remove="wwwroot\lessons\**\04-template.txt" />
    <Content Remove="wwwroot\lessons\**\05-solution.txt" />
    <Content Remove="wwwroot\lessons\**\02-datamodel.json" />
    <Content Remove="wwwroot\lessons\**\06-cases.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Editor SOURCE files: at runtime the app imports only the pre-bundled
         wwwroot\js\editor.bundle.min.js (built offline with esbuild — see
         wwwroot\lib\codemirror\VERSION.txt for the procedure). The unminified
         entry module, the two grammar modules and the vendored CodeMirror ESM
         files stay in the repo as bundling inputs but must not ship. None of
         these patterns can match editor.bundle.min.js (exact filenames under
         wwwroot\js, plus the lib\codemirror subtree only). -->
    <Content Remove="wwwroot\lib\codemirror\**\*.js" />
    <Content Remove="wwwroot\lib\codemirror\VERSION.txt" />
    <Content Remove="wwwroot\js\editor.js" />
    <Content Remove="wwwroot\js\scriban-language.js" />
    <Content Remove="wwwroot\js\json-language.js" />
  </ItemGroup>

  <!-- ContentBuilder runs before the Blazor build computes static web assets so
       newly-generated .html siblings of the .md files get picked up. The tool
       itself does the mtime staleness check.

       We build ContentBuilder via the MSBuild task (sync, in-process) and then
       invoke the built DLL with `dotnet exec`. Using `dotnet run` here would
       spawn a second build that races with the solution-level build of
       ContentBuilder over apphost.exe. -->
  <Target Name="BuildContent" BeforeTargets="ResolveStaticWebAssetsInputs;BeforeBuild">
    <PropertyGroup>
      <_ContentBuilderProject>$(MSBuildThisFileDirectory)..\..\tools\ContentBuilder\ContentBuilder.csproj</_ContentBuilderProject>
      <_ContentBuilderGrammar>$(MSBuildThisFileDirectory)..\..\tools\ContentBuilder\grammars\scriban.tmLanguage.json</_ContentBuilderGrammar>
      <_ContentBuilderInput>$(MSBuildThisFileDirectory)wwwroot\lessons</_ContentBuilderInput>
      <_ContentBuilderDll>$(MSBuildThisFileDirectory)..\..\tools\ContentBuilder\bin\$(Configuration)\net10.0\ContentBuilder.dll</_ContentBuilderDll>
    </PropertyGroup>
    <MSBuild Projects="$(_ContentBuilderProject)" Targets="Build" Properties="Configuration=$(Configuration)" />
    <Exec Command="dotnet exec &quot;$(_ContentBuilderDll)&quot; --input &quot;$(_ContentBuilderInput)&quot; --grammar &quot;$(_ContentBuilderGrammar)&quot; --theme light"
          ConsoleToMsBuild="true" />
  </Target>

</Project>
