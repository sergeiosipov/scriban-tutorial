@inject ContentService Content
@inject ProgressService Progress
@inject ThemeService Theme
@inject IJSRuntime JS
@implements IDisposable

<nav class="nav-menu" aria-label="Course navigation">
    <div class="nav-menu__brand">
        <div class="nav-menu__title-row">
            <div>
                <div class="nav-menu__title">@(_manifest?.CourseTitle ?? "Scriban Tutorial")</div>
                <div class="nav-menu__subtitle">@(_manifest?.CourseSubtitle ?? "Loading…")</div>
            </div>
            <button class="nav-menu__theme"
                    type="button"
                    title="@(Theme.IsDark ? "Switch to light theme" : "Switch to dark theme")"
                    aria-label="@(Theme.IsDark ? "Switch to light theme" : "Switch to dark theme")"
                    @onclick="ToggleTheme">
                @(Theme.IsDark ? "☼" : "☾")
            </button>
        </div>
    </div>
    @if (_manifest is not null)
    {
        <ul class="nav-menu__list">
            <li class="nav-menu__item">
                <NavLink class="nav-menu__link" href="" Match="NavLinkMatch.All">
                    <span class="nav-menu__num" aria-hidden="true">≡</span>
                    <span class="nav-menu__label">Course home</span>
                </NavLink>
            </li>
            <li class="nav-menu__item">
                <NavLink class="nav-menu__link" href="playground">
                    <span class="nav-menu__num" aria-hidden="true">✎</span>
                    <span class="nav-menu__label">Playground</span>
                </NavLink>
            </li>
            @foreach (var (lesson, index) in _manifest.Lessons.Select((l, i) => (l, i + 1)))
            {
                var state = GetLessonState(lesson);
                <li class="nav-menu__item">
                    <NavLink class="nav-menu__link"
                             href="@($"lesson/{lesson.Id}")"
                             aria-label="@($"Lesson {index}: {lesson.Title} ({StateTitle(state)})")">
                        <span class="nav-menu__num" aria-hidden="true">@index.ToString("D2")</span>
                        <span class="nav-menu__label">@lesson.Title</span>
                        <span class="nav-menu__progress nav-menu__progress--@state.ToString().ToLowerInvariant()"
                              data-state="@state.ToString().ToLowerInvariant()"
                              aria-hidden="true"
                              title="@StateTitle(state)"></span>
                    </NavLink>
                </li>
            }
        </ul>
        <div class="nav-menu__footer">
            <button type="button"
                    class="nav-menu__reset"
                    title="Erase all saved progress for every lesson"
                    @onclick="ResetAllProgress">
                Reset all progress
            </button>
        </div>
    }
</nav>

@code {
    private Manifest? _manifest;
    private Dictionary<string, IReadOnlyDictionary<string, ExerciseProgress>> _progressByLesson = new();

    enum LessonState { NotStarted, InProgress, Complete }

    protected override async Task OnInitializedAsync()
    {
        Progress.Changed += OnProgressChanged;
        Theme.Changed += OnThemeChanged;
        try
        {
            await Theme.InitializeAsync();
            _manifest = await Content.InitializeAsync();
            await RefreshProgress();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"NavMenu: init failed — {ex.Message}");
        }
    }

    private async Task RefreshProgress()
    {
        if (_manifest is null) return;
        var fresh = new Dictionary<string, IReadOnlyDictionary<string, ExerciseProgress>>();
        foreach (var lesson in _manifest.Lessons)
            fresh[lesson.Id] = await Progress.GetAllForLessonAsync(lesson.Id);
        _progressByLesson = fresh;
    }

    private void OnProgressChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshProgress();
            StateHasChanged();
        });
    }

    private void OnThemeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme() => await Theme.ToggleAsync();

    private async Task ResetAllProgress()
    {
        bool confirmed;
        try
        {
            confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                "Erase saved code and pass/fail state for every exercise? This cannot be undone.");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"NavMenu: confirm prompt failed — {ex.GetType().Name}");
            return;
        }
        if (!confirmed) return;
        try
        {
            await Progress.ResetAllAsync();
            // ResetAllAsync raises Changed; OnProgressChanged refreshes the indicators.
            // We also reload the current page so any open ExerciseBlock re-reads its
            // restored state. Simpler than threading a "reset" signal through.
            await JS.InvokeVoidAsync("location.reload");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"NavMenu: reset-all failed — {ex.GetType().Name}");
        }
    }

    private LessonState GetLessonState(LessonEntry lesson)
    {
        if (lesson.Exercises.Count == 0) return LessonState.NotStarted;
        if (!_progressByLesson.TryGetValue(lesson.Id, out var lessonProgress) || lessonProgress.Count == 0)
            return LessonState.NotStarted;
        var passed = lessonProgress.Values.Count(p => p.Passed);
        if (passed == lesson.Exercises.Count) return LessonState.Complete;
        return LessonState.InProgress;
    }

    private static string StateTitle(LessonState s) => s switch
    {
        LessonState.Complete => "complete",
        LessonState.InProgress => "in progress",
        _ => "not started",
    };

    public void Dispose()
    {
        Progress.Changed -= OnProgressChanged;
        Theme.Changed -= OnThemeChanged;
    }
}
