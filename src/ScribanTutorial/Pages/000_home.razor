@page "/"
@inject ContentService Content
@inject ProgressService Progress
@implements IDisposable

<PageTitle>Scriban Interactive Training</PageTitle>

@if (_manifest is null)
{
    <div class="home__loading">Loading…</div>
}
else
{
    <header class="home__header">
        <h1>@_manifest.CourseTitle</h1>
        <p class="home__subtitle">@_manifest.CourseSubtitle</p>
    </header>
    @if (_continueHref is not null)
    {
        <a class="home__continue" href="@_continueHref">
            <span class="home__continue-kicker">Continue where you left off</span>
            <span class="home__continue-lesson">@_continueLessonTitle</span>
            <span class="home__continue-exercise">@_continueExerciseTitle</span>
            <span class="home__continue-arrow" aria-hidden="true">→</span>
        </a>
    }
    <ul class="home__lessons">
        <li class="home__lesson">
            <a class="home__lesson-link home__lesson-link--about" href="about">
                <span class="home__lesson-num">About</span>
                <span class="home__lesson-title">What this app is, what it teaches</span>
                <span class="home__lesson-count">overview</span>
            </a>
        </li>
        <li class="home__lesson">
            <a class="home__lesson-link home__lesson-link--playground" href="playground">
                <span class="home__lesson-num">Playground</span>
                <span class="home__lesson-title">Free-form Scriban</span>
                <span class="home__lesson-count">live editor</span>
            </a>
        </li>
        <li class="home__lesson">
            <a class="home__lesson-link home__lesson-link--search" href="search">
                <span class="home__lesson-num">Search</span>
                <span class="home__lesson-title">Find a function, keyword, or topic</span>
                <span class="home__lesson-count">full-text</span>
            </a>
        </li>
        <li class="home__lesson">
            <a class="home__lesson-link home__lesson-link--reference" href="reference">
                <span class="home__lesson-num">Reference</span>
                <span class="home__lesson-title">Function reference</span>
                <span class="home__lesson-count">Every built-in, one page</span>
            </a>
        </li>
        @{ var n = 0; string? currentGroup = null; }
        @foreach (var lesson in _manifest.Lessons)
        {
            n++;
            var idx = n;
            var group = GroupFor(lesson.Id);
            if (group is not null && group != currentGroup)
            {
                currentGroup = group;
                <li class="home__group">
                    <h2 class="home__group-title">@group</h2>
                </li>
            }
            var total = lesson.Exercises.Count;
            var passed = _passedByLesson.TryGetValue(lesson.Id, out var p) ? p : 0;
            <li class="home__lesson">
                <a class="home__lesson-link" href="@($"lesson/{lesson.Id}")">
                    <span class="home__lesson-num">Lesson @idx.ToString("D2")</span>
                    <span class="home__lesson-main">
                        <span class="home__lesson-title">@lesson.Title</span>
                        @if (!string.IsNullOrWhiteSpace(lesson.Description))
                        {
                            <span class="home__lesson-desc">@lesson.Description</span>
                        }
                    </span>
                    <span class="home__lesson-count">
                        @total exercise@(total == 1 ? "" : "s")
                        @if (passed > 0)
                        {
                            <span class="home__lesson-passed @(passed >= total ? "home__lesson-passed--done" : null)">
                                @(passed >= total ? "✓" : null) @passed/@total passed
                            </span>
                        }
                    </span>
                </a>
            </li>
        }
        <li class="home__lesson">
            <a class="home__lesson-link home__lesson-link--contribute" href="contribute">
                <span class="home__lesson-num">Contribute</span>
                <span class="home__lesson-title">Add a lesson — no code required</span>
                <span class="home__lesson-count">walkthrough</span>
            </a>
        </li>
    </ul>
    <PageNav />
}

@code {
    private Manifest? _manifest;
    private Dictionary<string, int> _passedByLesson = new();
    private string? _continueHref;
    private string? _continueLessonTitle;
    private string? _continueExerciseTitle;

    protected override async Task OnInitializedAsync()
    {
        Progress.Changed += OnProgressChanged;
        try
        {
            _manifest = await Content.InitializeAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Home: failed to load manifest — {ex.Message}");
            return;
        }
        try
        {
            await RefreshProgressAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Home: failed to load progress — {ex.Message}");
        }
    }

    // Section headers are derived from the numeric lesson-id prefix (ids are
    // stable: 01..09 fundamentals, 10..17 libraries, 18+ wrap-up) so a
    // reordered manifest keeps grouping correctly without index bookkeeping.
    private static string? GroupFor(string lessonId)
    {
        var dash = lessonId.IndexOf('-');
        if (dash <= 0 || !int.TryParse(lessonId[..dash], out var num)) return null;
        return num switch
        {
            <= 9 => "Language fundamentals",
            <= 17 => "Built-in function libraries",
            _ => "Wrap-up",
        };
    }

    private async Task RefreshProgressAsync()
    {
        if (_manifest is null) return;

        var fresh = new Dictionary<string, int>();
        foreach (var lesson in _manifest.Lessons)
        {
            var records = await Progress.GetAllForLessonAsync(lesson.Id);
            fresh[lesson.Id] = records.Values.Count(r => r.Passed);
        }
        _passedByLesson = fresh;

        _continueHref = null;
        _continueLessonTitle = null;
        _continueExerciseTitle = null;
        var recent = await Progress.GetMostRecentAsync();
        if (recent is { } r)
        {
            // Only surface the card while the lesson still exists in the
            // manifest — a stale record pointing at a removed lesson would
            // otherwise link into a "lesson not found" page.
            var lesson = _manifest.Lessons.FirstOrDefault(l => l.Id == r.LessonId);
            if (lesson is not null)
            {
                var exercise = lesson.Exercises.FirstOrDefault(e => e.Id == r.Progress.ExerciseId);
                _continueHref = $"lesson/{r.LessonId}#exercise-{r.Progress.ExerciseId}";
                _continueLessonTitle = lesson.Title;
                _continueExerciseTitle = exercise?.DisplayTitle ?? r.Progress.ExerciseId;
            }
        }
    }

    private void OnProgressChanged()
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await RefreshProgressAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Home: progress refresh failed — {ex.GetType().Name}");
            }
        });
    }

    public void Dispose() => Progress.Changed -= OnProgressChanged;
}
