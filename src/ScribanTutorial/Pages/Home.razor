@page "/"
@inject ContentService Content

<PageTitle>Scriban Interactive Training</PageTitle>

@if (_manifest is null)
{
    <div class="home__loading">Loading…</div>
}
else
{
    <header class="home__header">
        <h1>@_manifest.CourseTitle</h1>
        <p class="home__subtitle">@_manifest.CourseSubtitle</p>
    </header>
    <ul class="home__lessons">
        <li class="home__lesson">
            <a class="home__lesson-link home__lesson-link--about" href="about">
                <span class="home__lesson-num">About</span>
                <span class="home__lesson-title">What this app is, what it teaches</span>
                <span class="home__lesson-count">overview</span>
            </a>
        </li>
        <li class="home__lesson">
            <a class="home__lesson-link home__lesson-link--playground" href="playground">
                <span class="home__lesson-num">Playground</span>
                <span class="home__lesson-title">Free-form Scriban</span>
                <span class="home__lesson-count">live editor</span>
            </a>
        </li>
        @{ var n = 0; }
        @foreach (var lesson in _manifest.Lessons)
        {
            n++;
            var idx = n;
            <li class="home__lesson">
                <a class="home__lesson-link" href="@($"lesson/{lesson.Id}")">
                    <span class="home__lesson-num">Lesson @idx.ToString("D2")</span>
                    <span class="home__lesson-title">@lesson.Title</span>
                    <span class="home__lesson-count">@lesson.Exercises.Count exercise@(lesson.Exercises.Count == 1 ? "" : "s")</span>
                </a>
            </li>
        }
        <li class="home__lesson">
            <a class="home__lesson-link home__lesson-link--contribute" href="contribute">
                <span class="home__lesson-num">Contribute</span>
                <span class="home__lesson-title">Add a lesson — no code required</span>
                <span class="home__lesson-count">walkthrough</span>
            </a>
        </li>
    </ul>
    <PageNav Next="_next" />
}

@code {
    private Manifest? _manifest;
    // Home is the start of the linear nav chain (Home → About → Playground →
    // Lesson 01..N → Contribute), so Prev is always null and Next always
    // points at About. Building the target eagerly keeps the PageNav stable
    // even before the manifest fetch completes.
    private readonly PageNav.NavTarget _next = new("about", "About");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _manifest = await Content.InitializeAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Home: failed to load manifest — {ex.Message}");
        }
    }
}
