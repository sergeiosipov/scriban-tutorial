@page "/lesson/{LessonId}"
@inject ContentService Content
@implements IDisposable

<PageTitle>@(_lesson?.Entry.Title ?? "Lesson") · Scriban Tutorial</PageTitle>

@if (_error is not null)
{
    <article class="lesson lesson--error">
        <h1>Lesson not found</h1>
        <p>@_error</p>
        <a href="">Back to the course index</a>
    </article>
}
else if (_lesson is null)
{
    <div class="lesson__loading" role="status" aria-live="polite">Loading lesson…</div>
}
else
{
    <article class="lesson">
        <header class="lesson__header">
            <div class="lesson__eyebrow">Lesson</div>
            <h1>@_lesson.Entry.Title</h1>
        </header>
        <TheoryBlock Html="@_lesson.TheoryHtml" />
        @* @key forces a fresh ExerciseBlock instance when LessonId changes.
           Without it, Blazor diffs by position and reuses the lesson 01 hello
           block for the first slot of every subsequent lesson — carrying its
           OnInitializedAsync-loaded progress (template, attempts, status) into
           upcase, list-loop, invoice, etc. *@
        @foreach (var ex in _lesson.Exercises)
        {
            <ExerciseBlock @key="(LessonId, ex.Id)"
                           LessonId="@LessonId"
                           ExerciseId="@ex.Id"
                           Content="@ex.Content" />
        }
        <PageNav Prev="_prev" Next="_next" />
    </article>
}

@code {
    [Parameter] public string LessonId { get; set; } = "";

    private LessonContent? _lesson;
    private string? _error;
    private CancellationTokenSource? _cts;
    private PageNav.NavTarget? _prev;
    private PageNav.NavTarget? _next;

    protected override async Task OnParametersSetAsync()
    {
        // Cancel any in-flight load if the user navigates between lessons quickly.
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        _lesson = null;
        _error = null;
        _prev = null;
        _next = null;
        StateHasChanged();
        try
        {
            _lesson = await Content.LoadLessonAsync(LessonId, ct);
            // LoadLessonAsync ran through InitializeAsync internally, so this
            // call hits the memoised manifest task — no extra fetch.
            ComputeNav(await Content.InitializeAsync());
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // User left this lesson; the next OnParametersSetAsync owns the UI now.
        }
        catch (KeyNotFoundException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"LessonPage: load failed for lesson '{LessonId}' ({ex.GetType().Name})");
            _error = "Could not load the lesson content. Try reloading.";
        }
    }

    private void ComputeNav(Manifest manifest)
    {
        // Sidebar order is Course home → About → Playground → Lesson 01 …
        // Lesson N → Contribute a lesson. The prev/next chain follows that
        // order: the first lesson's prev is Playground; the last lesson's
        // next is Contribute.
        var lessons = manifest.Lessons;
        var idx = -1;
        for (var i = 0; i < lessons.Count; i++)
        {
            if (lessons[i].Id == LessonId) { idx = i; break; }
        }
        if (idx < 0) return;

        _prev = idx == 0
            ? new PageNav.NavTarget("playground", "Playground")
            : new PageNav.NavTarget($"lesson/{lessons[idx - 1].Id}", lessons[idx - 1].Title);

        _next = idx == lessons.Count - 1
            ? new PageNav.NavTarget("contribute", "Contribute a lesson")
            : new PageNav.NavTarget($"lesson/{lessons[idx + 1].Id}", lessons[idx + 1].Title);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
