@page "/playground"
@using System.Text.Json
@using Scriban
@using Scriban.Runtime
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Playground · Scriban Tutorial</PageTitle>

<article class="playground">
    <header class="playground__header">
        <div class="playground__header-text">
            <h1>Playground</h1>
            <p class="playground__intro">
                Free-form Scriban. Edit the data model and template; output
                re-renders as you type. The default example transforms a
                vendor's raw fund data into the OpenFund v1 disclosure format.
            </p>
        </div>
        <button type="button"
                class="playground__reset"
                title="Restore the default example"
                @onclick="ResetToDefault">
            <span class="playground__reset-icon" aria-hidden="true">↺</span>
            <span>Reset example</span>
        </button>
    </header>

    <div class="playground__panel">
        <div class="playground__panel-label">Data model (JSON)</div>
        <div id="@_dataEditorId"
             class="playground__editor"
             role="textbox"
             aria-multiline="true"
             aria-label="JSON data model editor"></div>
    </div>

    <div class="playground__row">
        <div class="playground__panel">
            <div class="playground__panel-label">Template</div>
            <div id="@_templateEditorId"
                 class="playground__editor"
                 role="textbox"
                 aria-multiline="true"
                 aria-label="Scriban template editor"></div>
        </div>
        <div class="playground__panel">
            <div class="playground__panel-label">@(_errors is null ? "Output" : "Error")</div>
            @if (_errors is null)
            {
                <pre class="playground__pre"><code>@_output</code></pre>
            }
            else
            {
                <pre class="playground__pre playground__pre--err"><code>@_errors</code></pre>
            }
        </div>
    </div>
</article>

@code {
    // Vendor-shaped fund payload that needs to be reshaped into a normalised
    // OpenFund-style disclosure. Demonstrates nested-object access, array
    // iteration with for.index, arithmetic, pad_right / pad_left filters,
    // and whitespace control.
    private const string DefaultData = """
        {
          "fund": {
            "id": "XYZ-2024-A",
            "name": "Atlas Growth Fund",
            "manager": "Atlas Capital Partners",
            "currency": "USD",
            "inception_date": "2024-03-15",
            "nav": 142.85,
            "nav_date": "2026-05-22",
            "cash_pct": 23.5,
            "holdings": [
              { "ticker": "NVDA",  "shares":  6300, "weight_pct": 22.4 },
              { "ticker": "AAPL",  "shares": 12500, "weight_pct": 18.5 },
              { "ticker": "MSFT",  "shares":  8900, "weight_pct": 14.2 },
              { "ticker": "GOOGL", "shares":  4100, "weight_pct": 11.8 },
              { "ticker": "JPM",   "shares":  9700, "weight_pct":  9.6 }
            ]
          }
        }
        """;

    private const string DefaultTemplate = """
        === OpenFund v1 Standard Disclosure ===
        Fund ID:      {{ fund.id }}
        Legal Name:   {{ fund.name }}
        Manager:      {{ fund.manager }}
        Inception:    {{ fund.inception_date }}
        Currency:     {{ fund.currency }}

        Valuation (as of {{ fund.nav_date }})
          NAV per Unit: {{ fund.nav }} {{ fund.currency }}

        Allocation
          Holdings:   {{ fund.holdings | array.size }}
          Cash:       {{ fund.cash_pct }}%
          Equities:   {{ 100 - fund.cash_pct }}%

        Top Holdings (by weight, descending)
        {{- for h in fund.holdings }}
          {{ for.index + 1 }}. {{ h.ticker | string.pad_right 6 }}{{ h.weight_pct | string.pad_left 6 }}%   ({{ h.shares | string.pad_left 6 }} sh)
        {{- end }}

        Compliance: This output follows the OpenFund schema v1.
        """;

    private readonly string _dataEditorId = "playground-data";
    private readonly string _templateEditorId = "playground-template";

    private string _data = DefaultData;
    private string _template = DefaultTemplate;
    private string _output = "";
    private string? _errors;

    private IJSObjectReference? _editorModule;
    private DotNetObjectReference<Playground>? _dotnetRef;
    private bool _mounted;
    private System.Threading.Timer? _debounce;

    protected override void OnInitialized()
    {
        // Render the defaults synchronously so the Output panel isn't empty
        // before the first keystroke.
        Render();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _mounted) return;
        try
        {
            _editorModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/editor.js");
            _dotnetRef = DotNetObjectReference.Create(this);
            // autoFit:false because Playground panels are a fixed --pane-default-cap
            // tall — the editor fills that via flex, not via a JS-measured height.
            await _editorModule.InvokeVoidAsync(
                "mount", _dataEditorId, _data, _dotnetRef,
                new { callbackMethod = "OnDataChange", autoFit = false });
            await _editorModule.InvokeVoidAsync(
                "mount", _templateEditorId, _template, _dotnetRef,
                new { language = "scriban", callbackMethod = "OnTemplateChange", autoFit = false });
            _mounted = true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Playground: editor mount failed — {ex.GetType().Name}");
        }
    }

    [JSInvokable]
    public Task OnDataChange(string text)
    {
        _data = text;
        ScheduleRender();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnTemplateChange(string text)
    {
        _template = text;
        ScheduleRender();
        return Task.CompletedTask;
    }

    private void ScheduleRender()
    {
        // Debounce 250 ms so we don't re-parse / re-render on every keystroke.
        _debounce?.Dispose();
        _debounce = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                Render();
                StateHasChanged();
            });
        }, null, 250, System.Threading.Timeout.Infinite);
    }

    private void Render()
    {
        try
        {
            using var doc = JsonDocument.Parse(_data);
            var script = new ScriptObject();
            JsonToScriban.Import(doc.RootElement, script);

            var template = Template.Parse(_template);
            if (template.HasErrors)
            {
                _errors = string.Join("\n", template.Messages.Select(m => m.ToString()));
                _output = "";
                return;
            }

            var ctx = new TemplateContext
            {
                MemberRenamer = m => m.Name,
                LoopLimit = 100_000,
                RecursiveLimit = 100,
            };
            ctx.PushGlobal(script);
            _output = template.Render(ctx);
            _errors = null;
        }
        catch (JsonException ex)
        {
            _errors = $"Data model isn't valid JSON: {ex.Message}";
            _output = "";
        }
        catch (Exception ex)
        {
            _errors = ex.Message;
            _output = "";
        }
    }

    private async Task ResetToDefault()
    {
        _data = DefaultData;
        _template = DefaultTemplate;
        Render();
        if (_mounted && _editorModule is not null)
        {
            try
            {
                await _editorModule.InvokeVoidAsync("setValue", _dataEditorId, _data);
                await _editorModule.InvokeVoidAsync("setValue", _templateEditorId, _template);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Playground: reset setValue failed — {ex.GetType().Name}");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _debounce?.Dispose();
        if (_mounted && _editorModule is not null)
        {
            try { await _editorModule.InvokeVoidAsync("destroy", _dataEditorId); } catch { }
            try { await _editorModule.InvokeVoidAsync("destroy", _templateEditorId); } catch { }
        }
        if (_editorModule is not null)
        {
            try { await _editorModule.DisposeAsync(); } catch { }
        }
        _dotnetRef?.Dispose();
    }
}
