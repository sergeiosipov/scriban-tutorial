@page "/lesson/{LessonId}"
@inject ContentService Content
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@(_lesson?.Entry.Title ?? "Lesson") · Scriban Tutorial</PageTitle>

@if (_error is not null)
{
    <article class="lesson lesson--error">
        <h1>Lesson not found</h1>
        <p>@_error</p>
        <a href="">Back to the course index</a>
    </article>
}
else if (_lesson is null)
{
    <div class="lesson__loading" role="status" aria-live="polite">Loading lesson…</div>
}
else
{
    <article class="lesson">
        <header class="lesson__header">
            <div class="lesson__eyebrow">Lesson</div>
            <h1>@_lesson.Entry.Title</h1>
        </header>
        <TheoryBlock Html="@_lesson.TheoryHtml" />
        @* @key forces a fresh ExerciseBlock instance when LessonId changes.
           Without it, Blazor diffs by position and reuses the lesson 01 hello
           block for the first slot of every subsequent lesson — carrying its
           OnInitializedAsync-loaded progress (template, attempts, status) into
           upcase, list-loop, invoice, etc. *@
        @foreach (var ex in _lesson.Exercises)
        {
            <ExerciseBlock @key="(LessonId, ex.Id)"
                           LessonId="@LessonId"
                           ExerciseId="@ex.Id"
                           Content="@ex.Content" />
        }
        <PageNav />
    </article>
}

@code {
    [Parameter] public string LessonId { get; set; } = "";

    // Lesson IDs that learners may have bookmarked or linked from outside
    // the site. When the course inserts new lessons, the displaced IDs land
    // here so the old URL keeps working instead of 404ing.
    private static readonly Dictionary<string, string> LegacyLessonIds = new()
    {
        ["10-best-practices"] = "18-best-practices",
    };

    private LessonContent? _lesson;
    private string? _error;
    private CancellationTokenSource? _cts;

    protected override async Task OnParametersSetAsync()
    {
        if (LegacyLessonIds.TryGetValue(LessonId, out var current))
        {
            Nav.NavigateTo($"lesson/{current}", replace: true);
            return;
        }

        // Cancel any in-flight load if the user navigates between lessons quickly.
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        _lesson = null;
        _error = null;
        StateHasChanged();
        try
        {
            _lesson = await Content.LoadLessonAsync(LessonId, ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // User left this lesson; the next OnParametersSetAsync owns the UI now.
        }
        catch (KeyNotFoundException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"LessonPage: load failed for lesson '{LessonId}' ({ex.GetType().Name})");
            _error = "Could not load the lesson content. Try reloading.";
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
