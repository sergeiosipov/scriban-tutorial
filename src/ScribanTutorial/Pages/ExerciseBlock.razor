@using DiffPlex.DiffBuilder
@using DiffPlex.DiffBuilder.Model
@inject ProgressService Progress
@inject TemplateCache Templates
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="exercise"
         id="@($"exercise-{ExerciseId}")"
         aria-labelledby="@($"exercise-title-{ExerciseId}")"
         aria-busy="@(_running ? "true" : "false")">
    <header class="exercise__header">
        <h2 class="exercise__title" id="@($"exercise-title-{ExerciseId}")">@ExerciseId</h2>
        <span class="exercise__badge exercise__badge--@_status.ToString().ToLowerInvariant()"
              role="status"
              aria-live="polite"
              aria-atomic="true">
            @StatusLabel(_status)
        </span>
    </header>

    <div class="exercise__description">
        @((MarkupString)Content.DescriptionHtml)
    </div>

    <div class="exercise__panels">
        <div class="exercise__panel">
            <div class="exercise__panel-label">Data model</div>
            <div class="exercise__panel-code">@((MarkupString)Content.DataModelHtml)</div>
        </div>
        <div class="exercise__panel">
            <div class="exercise__panel-label">Expected output</div>
            <pre class="exercise__pre exercise__pre--expected"><code>@Content.Expected</code></pre>
        </div>
    </div>

    <label class="exercise__editor-label" for="@_editorId" id="@($"editor-label-{ExerciseId}")">
        Your template
        @if (_attempts > 0)
        {
            <span class="exercise__attempts">· @_attempts attempt@(_attempts == 1 ? "" : "s")</span>
        }
    </label>
    <div id="@_editorId"
         class="exercise__editor exercise__editor--cm"
         role="textbox"
         aria-multiline="true"
         aria-labelledby="@($"editor-label-{ExerciseId}")"
         aria-label="@($"Scriban template editor for {ExerciseId}")"></div>

    <div class="exercise__actions">
        <button class="exercise__btn exercise__btn--primary" @onclick="RunTemplate" disabled="@_running">
            @(_running ? "Running…" : "Submit code")
        </button>
        <button class="exercise__btn" @onclick="ResetTemplate" disabled="@_running">Reset</button>
        <button class="exercise__btn" @onclick="ToggleSolution" disabled="@_running">
            @(_revealSolution ? "Hide solution" : "Show solution")
        </button>
    </div>

    @if (_revealSolution)
    {
        <div class="exercise__solution">
            <div class="exercise__result-label">Solution</div>
            <pre class="exercise__pre exercise__pre--solution"><code>@Content.Solution</code></pre>
        </div>
    }

    @* Three mutually-exclusive result panels:
        - Pass:                 just the rendered output.
        - Fail, template ran:   just the diff (each diff line carries the
                                actual text, so a separate output panel
                                would duplicate it).
        - Fail, template didn't run (parse / runtime error): just the error. *@
    @if (_status == Status.Pass)
    {
        <div class="exercise__result exercise__result--pass">
            <div class="exercise__result-label">Output</div>
            <pre class="exercise__pre"><code>@_output</code></pre>
        </div>
    }
    else if (_status == Status.Fail && _diff is not null)
    {
        <div class="exercise__result exercise__result--fail">
            <div class="exercise__result-label">Diff (expected vs. actual)</div>
            <pre class="exercise__pre exercise__pre--diff"><code>@foreach (var line in _diff.Lines)
{
    var cls = line.Type switch
    {
        ChangeType.Inserted => "diff__line diff__line--ins",
        ChangeType.Deleted  => "diff__line diff__line--del",
        ChangeType.Modified => "diff__line diff__line--mod",
        _                    => "diff__line",
    };
    var prefix = line.Type switch
    {
        ChangeType.Inserted => "+ ",
        ChangeType.Deleted  => "- ",
        ChangeType.Modified => "~ ",
        _                    => "  ",
    };
    <span class="@cls">@(prefix)@(line.Text)<br /></span>
}</code></pre>
        </div>
    }
    else if (_status == Status.Fail && !string.IsNullOrEmpty(_errors))
    {
        <div class="exercise__result exercise__result--fail">
            <div class="exercise__result-label">Parse / runtime errors</div>
            <pre class="exercise__pre exercise__pre--err"><code>@_errors</code></pre>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string LessonId { get; set; } = "";
    [Parameter, EditorRequired] public string ExerciseId { get; set; } = "";
    [Parameter, EditorRequired] public ExerciseContent Content { get; set; } = default!;

    enum Status { Idle, Pass, Fail }

    private string _editorId = "";
    private string _userTemplate = "";
    private string _output = "";
    private string? _errors;
    private DiffPaneModel? _diff;
    private Status _status = Status.Idle;
    private bool _running;
    private bool _revealSolution;
    private int _attempts;
    private bool _restored;

    private IJSObjectReference? _editorModule;
    private DotNetObjectReference<ExerciseBlock>? _dotnetRef;
    private bool _editorMounted;

    protected override async Task OnInitializedAsync()
    {
        _editorId = $"editor-{LessonId}-{ExerciseId}";
        _userTemplate = Content.StarterTemplate;

        // Pre-parse the canonical solution in the background. Scriban parse can take
        // a few hundred ms on WASM for non-trivial templates; doing it lazily here
        // means a later "verify the solution still works" path (or a side-by-side
        // run) is instant. Fire-and-forget; we don't await.
        _ = Task.Run(() =>
        {
            try { Templates.GetOrParse($"solution:{LessonId}:{ExerciseId}", Content.Solution); }
            catch { /* malformed solution would surface via --verify in CI */ }
        });

        try
        {
            var saved = await Progress.GetAsync(LessonId, ExerciseId);
            if (saved is not null)
            {
                _userTemplate = saved.LastCode;
                _attempts = saved.Attempts;
                _status = saved.Passed ? Status.Pass : Status.Fail;
                _restored = true;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"ExerciseBlock: progress restore failed for {ExerciseId} — {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _editorMounted) return;
        try
        {
            _editorModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/editor.js");
            _dotnetRef = DotNetObjectReference.Create(this);
            // Scriban grammar on, default OnEditorChange callback.
            await _editorModule.InvokeVoidAsync(
                "mount",
                _editorId,
                _userTemplate,
                _dotnetRef,
                new { language = "scriban", callbackMethod = "OnEditorChange" });
            _editorMounted = true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"ExerciseBlock: editor mount failed for {ExerciseId} — {ex.Message}");
        }
    }


    [JSInvokable]
    public Task OnEditorChange(string text)
    {
        _userTemplate = text;
        return Task.CompletedTask;
    }

    private async Task RunTemplate()
    {
        _running = true;
        _status = Status.Idle;
        _errors = null;
        _diff = null;
        _output = "";
        _attempts++;
        StateHasChanged();

        try
        {
            var result = ScribanRunner.Run(_userTemplate, Content.DataModelJson);
            if (!result.Ok)
            {
                _errors = result.Errors;
                _status = Status.Fail;
                return;
            }

            _output = result.Output;
            var actual = ContentNormalize.Normalize(_output);
            var expected = ContentNormalize.Normalize(Content.Expected);
            if (string.Equals(actual, expected, StringComparison.Ordinal))
            {
                _status = Status.Pass;
            }
            else
            {
                _status = Status.Fail;
                _diff = InlineDiffBuilder.Diff(expected, actual);
            }
        }
        finally
        {
            _running = false;
            await PersistAsync();
            StateHasChanged();
        }
    }

    private async Task ResetTemplate()
    {
        _userTemplate = Content.StarterTemplate;
        _status = Status.Idle;
        _output = "";
        _errors = null;
        _diff = null;
        _revealSolution = false;
        if (_editorMounted && _editorModule is not null)
        {
            try { await _editorModule.InvokeVoidAsync("setValue", _editorId, _userTemplate); }
            catch (Exception ex) { Console.Error.WriteLine($"ExerciseBlock: editor setValue failed — {ex.Message}"); }
        }
        await PersistAsync();
    }

    private void ToggleSolution() => _revealSolution = !_revealSolution;

    private async Task PersistAsync()
    {
        try
        {
            await Progress.SaveAsync(
                new ExerciseProgress(
                    ExerciseId,
                    _status == Status.Pass,
                    _userTemplate,
                    _attempts,
                    DateTimeOffset.UtcNow),
                LessonId);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"ExerciseBlock: persist failed for {ExerciseId} — {ex.Message}");
        }
    }

    private string StatusLabel(Status s) => s switch
    {
        Status.Pass => "Passed",
        Status.Fail => "Failed",
        _ => _restored ? "Not run this session" : "Not run",
    };

    public async ValueTask DisposeAsync()
    {
        if (_editorMounted && _editorModule is not null)
        {
            try { await _editorModule.InvokeVoidAsync("destroy", _editorId); }
            catch { /* navigation race is fine */ }
        }
        if (_editorModule is not null)
        {
            try { await _editorModule.DisposeAsync(); } catch { /* best effort */ }
        }
        _dotnetRef?.Dispose();
    }
}
