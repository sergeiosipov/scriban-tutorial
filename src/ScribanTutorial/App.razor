@using Microsoft.AspNetCore.Components.WebAssembly.Services
@inject LazyAssemblyLoader AssemblyLoader

<Router AppAssembly="@typeof(App).Assembly" OnNavigateAsync="@OnNavigateAsync">
    <Found Context="routeData">
        <ErrorBoundary>
            <ChildContent>
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent Context="ex">
                <LayoutView Layout="@typeof(MainLayout)">
                    <article class="lesson lesson--error">
                        <h1>Something broke on this page</h1>
                        <p>The lesson view failed to render. The sidebar still works — pick another lesson, or reload the page to recover.</p>
                        <details>
                            <summary>Technical detail</summary>
                            <pre><code>@ex.GetType().Name: @ex.Message</code></pre>
                        </details>
                    </article>
                </LayoutView>
            </ErrorContent>
        </ErrorBoundary>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <article class="lesson lesson--error">
                <h1>Page not found</h1>
                <p>That URL doesn't match a lesson. <a href="">Back to the course home</a>.</p>
            </article>
        </LayoutView>
    </NotFound>
</Router>

@code {
    // DiffPlex backs only the expected-vs-actual diff in ExerciseBlock/DiffView,
    // which render exclusively on lesson pages — so it's marked
    // BlazorWebAssemblyLazyLoad in the csproj (kept out of the initial app
    // download) and fetched here on the first navigation to a lesson route.
    private bool _diffPlexLoaded;

    private async Task OnNavigateAsync(NavigationContext context)
    {
        if (_diffPlexLoaded) return;
        if (!context.Path.TrimStart('/').StartsWith("lesson", StringComparison.OrdinalIgnoreCase)) return;
        try
        {
            await AssemblyLoader.LoadAssembliesAsync(new[] { "DiffPlex.wasm" });
            _diffPlexLoaded = true;
        }
        catch (Exception ex)
        {
            // Swallow here: if DiffPlex really is needed the lesson page's
            // ErrorBoundary surfaces the failure with a reload hint.
            Console.Error.WriteLine($"App: lazy load of DiffPlex failed — {ex.Message}");
        }
    }
}
