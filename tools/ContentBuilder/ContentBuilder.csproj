<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ContentBuilder</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="Scriban" Version="7.2.0" />
    <PackageReference Include="TextMateSharp" Version="2.0.3" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.3" />
  </ItemGroup>

  <!-- Share the single source of truth for output-comparison normalisation
       and JSON → Scriban conversion with the WASM project. Linked so a change
       in either pair-edits both. -->
  <ItemGroup>
    <Compile Include="..\..\src\ScribanTutorial\Services\ContentNormalize.cs"
             Link="Shared\ContentNormalize.cs" />
    <Compile Include="..\..\src\ScribanTutorial\Services\JsonToScriban.cs"
             Link="Shared\JsonToScriban.cs" />
    <Compile Include="..\..\src\ScribanTutorial\Services\ScribanRunner.cs"
             Link="Shared\ScribanRunner.cs" />
  </ItemGroup>

</Project>
