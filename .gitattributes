# Enforce LF line endings for all text files (per spec §0.5 / §14 check 14)
* text=auto eol=lf

# Explicit text types
*.cs        text eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf
*.razor     text eol=lf
*.json      text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.tmLanguage.json text eol=lf

# Binary files
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
